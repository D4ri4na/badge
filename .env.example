# Copiá este archivo a .env y ajustá lo que necesites. Nada de acá es un
# secreto: el generador no habla con ningún servicio, así que no hay
# credenciales que configurar en ninguna parte.
#
# `pnpm dev` lee .env solo si existe; si no está, valen los defaults.

# Puerto del servidor de archivos local (scripts/serve.mjs).
PORT=5173

# Bucket de S3 donde se van a subir los archivos estáticos.
BUCKET_NAME=""
CLOUDFRONT_DISTRIBUTION_ID=""
ROLE=""
ROLE_SESSION=""